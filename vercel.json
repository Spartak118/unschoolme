{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "index.html",
          "404.html",
          "favicon.svg",
          "*/index.html",
          "*/*/index.html",
          "css/**",
          "js/**",
          "data/knowledge.json"
        ]
      }
    }
  ],
  "routes": [{ "src": "/(.*)", "dest": "server.js" }]
}
